generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  phone               String    @unique
  role                Role      @default(USER)
  isActive            Boolean   @default(true)
  emailVerified       Boolean   @default(false)
  verificationCode    String?
  verificationExpires DateTime?
  inviteCode          String
  companyId           String?
  signature           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

model Company {
  id               String   @id @default(uuid())
  name             String
  address          String?
  phone            String?
  email            String?
  taxNumber        String?
  invitationCode   String   @unique
  logoUrl          String?
  profileCompleted Boolean  @default(false)
  isFrozen         Boolean  @default(false)
  paidUntil        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users          User[]
  adminKeys      AdminKey[]
  customers      Customer[]
  serviceRecords ServiceRecord[]
  teams          Team[]
  appointments   Appointment[]
}

model ServiceRecord {
  id           Int      @id @default(autoincrement())
  documentDate String
  customerName String
  customerId   String?
  serviceType  String
  address      String?
  startTime    String?
  endTime      String?
  phone        String?
  internalIp   String?
  externalIp   String?
  details      String?
  fee          String   @default("0.00")
  technician   String?
  services     String   @default("[]")
  technical    String   @default("[]")
  signed       Boolean  @default(false)
  paid         Boolean  @default(false)
  signature    String?
  technicianSignature String?
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([customerId])
}

model Customer {
  id            String   @id @default(uuid())
  companyName   String
  address       String?
  email         String?
  phone         String?
  contactPerson String?
  contactPhone  String?
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  leader    String
  color     String
  members   String   @default("[]")
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  appointments Appointment[]

  @@index([companyId])
}

model Appointment {
  id           Int      @id @default(autoincrement())
  customerName String
  customerId   String?
  teamName     String
  teamId       Int
  date         String
  startTime    String
  duration     String
  serviceType  String
  notes        String   @default("")
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([teamId])
}

model AdminKey {
  id              String    @id @default(uuid())
  keyValue        String    @unique
  isUsed          Boolean   @default(false)
  isActive        Boolean   @default(true)
  usedByCompanyId String?
  createdAt       DateTime  @default(now())
  usedAt          DateTime?

  company Company? @relation(fields: [usedByCompanyId], references: [id])
}
