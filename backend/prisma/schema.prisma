generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  phone               String    @unique
  role                Role      @default(USER)
  isActive            Boolean   @default(true)
  emailVerified       Boolean   @default(false)
  verificationCode    String?
  verificationExpires DateTime?
  inviteCode          String
  companyId           String?
  signature           String?
  resetCode           String?
  resetCodeExpires    DateTime?
  privacyAcceptedAt   DateTime?
  privacyPolicyVersion String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

model Company {
  id               String   @id @default(uuid())
  name             String
  address          String?
  phone            String?
  gsm              String?
  email            String?
  fax              String?
  website          String?
  taxNumber        String?
  invitationCode   String   @unique
  logoUrl          String?
  stampUrl         String?
  profileCompleted Boolean  @default(false)
  isFrozen         Boolean  @default(false)
  paidUntil        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users          User[]
  adminKeys      AdminKey[]
  customers      Customer[]
  serviceRecords ServiceRecord[]
  serviceTemplates ServiceFormTemplate[]
  teams          Team[]
  appointments   Appointment[]
  quoteRecords   QuoteRecord[]
  stockItems     StockItem[]
  invoices       Invoice[]
  invoiceLines   InvoiceLine[]
  stockTransactions StockTransaction[]
}

model ServiceRecord {
  id           Int      @id @default(autoincrement())
  documentDate String
  customerName String
  customerId   String?
  serviceType  String
  address      String?
  startTime    String?
  endTime      String?
  phone        String?
  internalIp   String?
  externalIp   String?
  details      String?
  fee          String   @default("0.00")
  technician   String?
  technicianPhone String?
  services     String   @default("[]")
  technical    String   @default("[]")
  customChips  String?
  customValues String?
  signed       Boolean  @default(false)
  paid         Boolean  @default(false)
  signature    String?
  technicianSignature String?
  templateName String?
  templateConfig String?
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([customerId])
}

model ServiceFormTemplate {
  id         String   @id @default(uuid())
  companyId  String
  name       String
  fields     String   @default("[]")
  chipGroups String   @default("[]")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Customer {
  id            String   @id @default(uuid())
  companyName   String
  subscriberNo  String?
  address       String?
  email         String?
  phone         String?
  fax           String?
  website       String?
  contactPerson String?
  contactPhone  String?
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  leader    String
  color     String
  members   String   @default("[]")
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  appointments Appointment[]

  @@index([companyId])
}

model Appointment {
  id           Int      @id @default(autoincrement())
  customerName String
  customerId   String?
  teamName     String
  teamId       Int
  date         String
  startTime    String
  duration     String
  serviceType  String
  notes        String   @default("")
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([teamId])
}

model QuoteRecord {
  id            Int      @id @default(autoincrement())
  title         String?
  documentDate  String
  customerName  String
  customerId    String?
  contactPerson String?
  email         String?
  phone         String?
  fax           String?
  website       String?
  address       String?
  subscriberNo  String?
  notes         String?
  lines         String   @default("[]") // JSON string: [{name, details, quantity, unitPrice, currency, unit}]
  validUntil    String?
  tryRates      String? // JSON string: TCMB rate snapshot at creation time
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([customerId])
}

model StockItem {
  id                Int      @id @default(autoincrement())
  name              String
  unit              String   @default("AD")
  quantity          Float    @default(0)
  minQuantity       Float    @default(0)
  unitPrice         Float?
  currency          String   @default("TRY")
  vatRate           Float    @default(0)
  supplierName      String?
  supplierTaxNumber String?
  lastInvoiceNo     String?
  lastInvoiceDate   String?
  notes             String?
  companyId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company      Company            @relation(fields: [companyId], references: [id])
  transactions StockTransaction[]
  invoiceLines InvoiceLine[]

  @@index([companyId])
  @@index([name])
}

model StockTransaction {
  id          Int      @id @default(autoincrement())
  stockItemId Int
  change      Float
  reason      String   @default("MANUAL")
  unitPrice   Float?
  currency    String   @default("TRY")
  invoiceId   Int?
  note        String?
  companyId   String
  createdAt   DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  @@index([stockItemId])
  @@index([companyId])
}

model Invoice {
  id                 Int      @id @default(autoincrement())
  invoiceNo          String
  invoiceType        String?
  date               String?
  supplierName       String?
  supplierTaxNumber  String?
  supplierAddress    String?
  totalAmount        Float?
  currency           String   @default("TRY")
  vatAmount          Float?
  rawName            String?
  companyId          String
  createdAt          DateTime @default(now())

  company      Company            @relation(fields: [companyId], references: [id])
  lines        InvoiceLine[]
  transactions StockTransaction[]

  @@index([companyId])
  @@unique([companyId, invoiceNo])
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  name        String
  quantity    Float
  unit        String?
  unitPrice   Float?
  lineAmount  Float?
  vatRate     Float?
  stockItemId Int?
  companyId   String

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  stockItem StockItem? @relation(fields: [stockItemId], references: [id])
  company   Company    @relation(fields: [companyId], references: [id])

  @@index([invoiceId])
}

model AdminKey {
  id              String    @id @default(uuid())
  keyValue        String    @unique
  isUsed          Boolean   @default(false)
  isActive        Boolean   @default(true)
  usedByCompanyId String?
  createdAt       DateTime  @default(now())
  usedAt          DateTime?

  company Company? @relation(fields: [usedByCompanyId], references: [id])
}
