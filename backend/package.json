{
  "name": "management-dashboard-backend",
  "version": "1.0.0",
  "description": "Management Dashboard Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "npx prisma migrate deploy && node dist/index.js",
    "seed": "ts-node src/seed.ts",
    "migrate": "npx prisma migrate dev",
    "generate": "npx prisma generate",
    "postinstall": "npx prisma generate",
    "db:backup": "docker exec dashboard-postgres pg_dump -U postgres -d management_dashboard | gzip > backups/backup_$(date +%Y%m%d_%H%M%S).sql.gz",
    "db:restore": "echo 'Kullanim: docker compose exec postgres sh /backups/restore.sh <dosya_adi>'"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imagetracerjs": "^1.2.6",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "nodemon": "^3.1.9",
    "prisma": "^6.11.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
