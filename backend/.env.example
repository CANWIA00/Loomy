# Kopyala: cp .env.example .env  (gercek degerleri git'e isleme)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/management_dashboard?schema=public"
JWT_SECRET="uzun-ve-rastgele-bir-deger-olustur"
PORT=8080

# Bos birakilirsa koddaki varsayilan CORS listesi kullanilir
ALLOWED_ORIGINS="http://localhost:8081,http://localhost:5173"
TRUST_PROXY_HOPS=1

# E-posta: SMTP veya SendGrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SENDGRID_API_KEY=
# SENDGRID_FROM=

APPLICATION_EMAIL=
APPLY_MAX_PER_HOUR=

# Gelistirici paneli (/dev); bos ise kapali
DEV_EMAIL=
DEV_PASSWORD=
