{
  "expo": {
    "name": "Loomy",
    "slug": "loomy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/loomy-dark.png",
    "userInterfaceStyle": "dark",
    "scheme": "loomy",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#181828",
        "foregroundImage": "./assets/loomy-dark.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/loomy-dark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Loomy, servis adresinizi belirlemek için konumunuzu kullanır.",
          "locationWhenInUsePermission": "Loomy, servis adresinizi belirlemek için konumunuzu kullanır."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
